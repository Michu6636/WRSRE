{
  "$schema": "https://app.kilo.ai/config.json",
  "compaction": {
    "auto": true,
    "threshold_percent": 75,
    "prune": true,
    "tail_turns": 2
  },
  "agent": {
    "autonomous-dev": {
      "description": "Fully autonomous WRSRE engineering lead. Investigates, queries Ghidra, edits, builds, tests, and verifies until independent reviewers approve with zero open defects.",
      "mode": "primary",
      "temperature": 0.2,
      "permission": {
        "task": {
          "*": "deny",
          "explore": "allow",
          "implementation-worker": "allow",
          "reviewer-focus1": "allow",
          "reviewer-focus2": "allow"
        },
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow"
        },
        "edit": {
          "*": "allow",
          ".kilo/*": "deny",
          ".kilocode/*": "deny",
          "*/.kilo/*": "deny",
          "*/.kilocode/*": "deny",
          "kilo.json": "deny",
          "kilo.jsonc": "deny",
          "opencode.json": "deny",
          "opencode.jsonc": "deny",
          "AGENTS.md": "deny",
          "AGENT.md": "deny",
          "*/AGENTS.md": "deny",
          "*/AGENT.md": "deny",
          "*.env": "deny",
          "*.env.*": "deny"
        },
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "todoread": "allow",
        "todowrite": "allow",
        "external_directory": {
          "*": "allow",
          "*/.config/kilo/*": "deny",
          "*/.kilo/*": "deny",
          "*/.kilocode/*": "deny"
        },
        "doom_loop": "ask",
        "goal": "allow",
        "goal_report": "allow",
        "agent_manager": "deny",
        "bash": {
          "*": "allow",
          "*git*": "deny",
          "*git*branch*": "deny",
          "*git*remote*": "deny",
          "*git*status*": "allow",
          "*git*diff*": "allow",
          "*git*log*": "allow",
          "*git*show*": "allow",
          "*git*ls-files*": "allow",
          "*git*rev-parse*": "allow",
          "*git*blame*": "allow",
          "*git*branch --show-current*": "allow",
          "*git*branch --list*": "allow",
          "*git*branch -a*": "allow",
          "*git*branch -r*": "allow",
          "*git*branch --all*": "allow",
          "*git*branch --remotes*": "allow",
          "*git*remote -v*": "allow",
          "*git*remote show*": "allow",
          "*git*push*": "deny",
          "*git*commit*": "deny",
          "*git*reset*": "deny",
          "*git*clean*": "deny",
          "*git*checkout*": "deny",
          "*git*switch*": "deny",
          "*git*restore*": "deny",
          "*git*rebase*": "deny",
          "*git*merge*": "deny",
          "*git*cherry-pick*": "deny",
          "*git*revert*": "deny",
          "*git*stash*": "deny",
          "*git*worktree*": "deny",
          "*git* am*": "deny",
          "*git*update-ref*": "deny",
          "*git*symbolic-ref*": "deny",
          "*git*filter-branch*": "deny",
          "*git*tag*": "deny",
          "*git*config*": "deny",
          "*kilo*": "deny"
        }
      },
      "prompt": "{file:./prompts/autonomous-dev.md}"
    },
    "implementation-worker": {
      "description": "Executes bounded, non-overlapping implementation subtasks assigned by the parent.",
      "mode": "all",
      "hidden": true,
      "temperature": 0.2,
      "permission": {
        "task": "deny",
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow"
        },
        "edit": {
          "*": "allow",
          ".kilo/*": "deny",
          ".kilocode/*": "deny",
          "*/.kilo/*": "deny",
          "*/.kilocode/*": "deny",
          "kilo.json": "deny",
          "kilo.jsonc": "deny",
          "opencode.json": "deny",
          "opencode.jsonc": "deny",
          "AGENTS.md": "deny",
          "AGENT.md": "deny",
          "*/AGENTS.md": "deny",
          "*/AGENT.md": "deny",
          "*.env": "deny",
          "*.env.*": "deny"
        },
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "external_directory": "deny",
        "doom_loop": "deny",
        "goal": "deny",
        "goal_report": "deny",
        "agent_manager": "deny",
        "bash": {
          "*": "allow",
          "*ghidra_run*": "deny",
          "*analyzeHeadless*": "deny",
          "*build.bat*": "deny",
          "*git*": "deny",
          "*git*branch*": "deny",
          "*git*remote*": "deny",
          "*git*status*": "allow",
          "*git*diff*": "allow",
          "*git*log*": "allow",
          "*git*show*": "allow",
          "*git*ls-files*": "allow",
          "*git*rev-parse*": "allow",
          "*git*blame*": "allow",
          "*git*branch --show-current*": "allow",
          "*git*branch --list*": "allow",
          "*git*branch -a*": "allow",
          "*git*branch -r*": "allow",
          "*git*branch --all*": "allow",
          "*git*branch --remotes*": "allow",
          "*git*remote -v*": "allow",
          "*git*remote show*": "allow",
          "*git*push*": "deny",
          "*git*commit*": "deny",
          "*git*reset*": "deny",
          "*git*clean*": "deny",
          "*git*checkout*": "deny",
          "*git*switch*": "deny",
          "*git*restore*": "deny",
          "*git*rebase*": "deny",
          "*git*merge*": "deny",
          "*git*cherry-pick*": "deny",
          "*git*revert*": "deny",
          "*git*stash*": "deny",
          "*git*worktree*": "deny",
          "*git* am*": "deny",
          "*git*update-ref*": "deny",
          "*git*symbolic-ref*": "deny",
          "*git*filter-branch*": "deny",
          "*git*tag*": "deny",
          "*git*config*": "deny",
          "*kilo*": "deny"
        }
      },
      "prompt": "{file:./prompts/implementation-worker.md}"
    },
    "reviewer-focus1": {
      "description": "Read-only reviewer: requirements, correctness, regressions, ABI.",
      "mode": "subagent",
      "hidden": true,
      "temperature": 0.1,
      "permission": {
        "*": "deny",
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow"
        },
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "external_directory": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "agent_manager": "deny",
        "goal": "deny",
        "goal_report": "deny",
        "question": "deny",
        "skill": "deny",
        "lsp": "deny",
        "todowrite": "deny",
        "doom_loop": "deny"
      },
      "prompt": "{file:./prompts/reviewer-focus1.md}"
    },
    "reviewer-focus2": {
      "description": "Read-only reviewer: tests, evidence, counterexamples, scope.",
      "mode": "subagent",
      "hidden": true,
      "temperature": 0.1,
      "permission": {
        "*": "deny",
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow"
        },
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "external_directory": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "agent_manager": "deny",
        "goal": "deny",
        "goal_report": "deny",
        "question": "deny",
        "skill": "deny",
        "lsp": "deny",
        "todowrite": "deny",
        "doom_loop": "deny"
      },
      "prompt": "{file:./prompts/reviewer-focus2.md}"
    }
  }
}
