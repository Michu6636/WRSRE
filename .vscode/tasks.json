{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "cmd",
            "args": ["/c", "${workspaceFolder}\\build.bat"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true,
                "echo": false
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build (clean)",
            "type": "shell",
            "command": "cmd",
            "args": ["/c", "${workspaceFolder}\\build.bat", "clean"],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true,
                "echo": false
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build (release)",
            "type": "shell",
            "command": "cmd",
            "args": ["/c", "${workspaceFolder}\\build.bat"],
            "group": {
                "kind": "build"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true,
                "echo": false
            },
            "problemMatcher": "$msCompile"
        }
    ]
}