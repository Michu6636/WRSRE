# Enforce LF for docs and source so CRLF uploads don't create noisy diffs
* text=auto
*.md text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.ini text eol=lf
*.txt text eol=lf
# Preserve the user's original CRLF loader log byte-for-byte.
export/almanac-evidence/almanac-button-visual-test-run1/tesmioloader-log.txt -text !eol
*.py text eol=lf
*.json text eol=lf
# Windows batch files keep CRLF
*.bat text eol=crlf
