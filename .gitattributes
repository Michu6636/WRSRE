# Enforce LF for docs and source so CRLF uploads don't create noisy diffs
* text=auto
*.md text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.ini text eol=lf
*.txt text eol=lf
# Preserve the user's original CRLF loader log byte-for-byte.
export/almanac-evidence/almanac-button-visual-test-run1/tesmioloader-log.txt -text !eol
*.py text eol=lf
*.json text eol=lf
# Windows batch files keep CRLF
*.bat text eol=crlf
# Vendored third-party mod sources keep their upstream bytes and hashes.
# They are evidence inputs (see "Mods for analysis"/README.md), not WRSRE code.
"Mods for analysis/**" -text
# Legacy Ghidra/PE asm dumps keep whatever the tool emitted.
# Some are UTF-16LE Ghidra output and some are raw byte dumps; normalising
# them would destroy the bytes they exist to preserve.
*.asm -text
# A raw memory hexdump: the non-ASCII bytes ARE the dumped data.
export/almanac-evidence/c3ddll64-panel-init-search-20261109/panel_raw_hex.txt -text
